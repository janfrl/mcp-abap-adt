{
  "name": "@janfr/mcp-abap-adt",
  "version": "2.7.0",
  "mcpName": "io.github.janfrl/mcp-abap-adt",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "mcp-abap-adt": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --dir tests/integration",
    "start": "node ./dist/index.js",
    "dev": "npm run inspect",
    "prepublishOnly": "npm run check",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "oxlint --type-aware src tests",
    "lint:fix": "oxlint --type-aware --fix src tests",
    "fmt": "oxfmt src tests vitest.config.ts",
    "fmt:check": "oxfmt --check src tests vitest.config.ts",
    "inspect": "npm run build && npx -y @modelcontextprotocol/inspector@2 node dist/index.js",
    "inspect:cli": "npm run build && npx -y @modelcontextprotocol/inspector@2 --cli node dist/index.js",
    "release": "node scripts/release.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check": "npm run build && npm test && npm run typecheck && npm run lint && npm run fmt:check && npm run check:package"
  },
  "keywords": [
    "abap",
    "sap",
    "adt",
    "mcp",
    "model-context-protocol"
  ],
  "author": "janfrl",
  "contributors": [
    "mario-andreschak (original author of mcp-abap-adt)"
  ],
  "description": "ABAP ADT (ABAP Development Tools) MCP Server for interacting with SAP systems",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janfrl/mcp-abap-adt.git"
  },
  "homepage": "https://github.com/janfrl/mcp-abap-adt#readme",
  "bugs": {
    "url": "https://github.com/janfrl/mcp-abap-adt/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@zowe/secrets-for-zowe-sdk": "^8.37.0",
    "c12": "^3.3.4",
    "defu": "^6.1.7",
    "ofetch": "^1.5.1",
    "rc9": "^3.1.0",
    "undici": "^8.11.0",
    "xml-js": "^1.6.11",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.10",
    "changelogen": "^0.6.2",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2002",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "changelog": {
    "types": {
      "feat": {
        "title": "🚀 Features",
        "semver": "minor"
      },
      "fix": {
        "title": "🩹 Fixes",
        "semver": "patch"
      },
      "perf": {
        "title": "⚡ Performance",
        "semver": "patch"
      },
      "refactor": {
        "title": "💅 Refactors",
        "semver": "patch"
      },
      "build": {
        "title": "📦 Build",
        "semver": "patch"
      },
      "docs": {
        "title": "📖 Documentation"
      },
      "chore": {
        "title": "🏡 Chore"
      },
      "test": false,
      "style": false,
      "ci": false
    }
  }
}

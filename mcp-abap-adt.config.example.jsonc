// Copy to mcp-abap-adt.config.jsonc and adjust, or pass the path with --config.
{
  "defaultSystem": "dev",
  "importFioriSystems": false,

  "systems": {
    // Password in the OS keychain: mcp-abap-adt store-credentials --system dev
    "dev": {
      "url": "https://dev.example.com:44300",
      "client": "100",
      "keychain": true
    },

    // Password from an environment variable.
    "qas": {
      "url": "https://qas.example.com:44300",
      "client": "200",
      "username": "DEVELOPER",
      "passwordEnv": "SAP_QAS_PASSWORD"
    },

    // Self-signed certificate; company CAs need nothing, the OS trust store is used.
    "sandbox": {
      "url": "https://vhcalnplci.dummy.nodomain:44300",
      "client": "001",
      "keychain": true,
      "allowSelfSigned": true
    }
  }
}
